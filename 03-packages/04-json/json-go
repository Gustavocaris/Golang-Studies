package main

import (
	"encoding/json"
	"fmt"
)

type Person struct {
	Name    string `json:"name"`
	Age     int    `json:"age"`
	Country string `json:"country"`
}

func main() {

	// 1. Criar uma pessoa
	person := Person{
		Name:    "Gustavo",
		Age:     53,
		Country: "Brazil",
	}

	// 2 - > cconverter Struct para JSON
	jsonData, err := json.MarshalIndent(person, "", "    ")
	if err != nil {
		fmt.Println("Erro ao converter para JSON:", err)
		return
	}

}
